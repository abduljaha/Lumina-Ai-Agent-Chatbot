# ============================================
# Application
# ============================================
# NEVER commit real secrets to this file - it's the template every developer
# copies to .env, and .env.example itself is meant to be safe to share/commit.
# SECRET_KEY/JWT_SECRET_KEY below must be overridden with a real random value
# before app_env=production - the app now refuses to start otherwise.
APP_NAME=Lumina AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ============================================
# Server
# ============================================
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ============================================
# Database (SQLite by default; set DATABASE_URL/DATABASE_SYNC_URL to a postgresql:// URL for production)
# ============================================
DATABASE_URL=sqlite+aiosqlite:///./ai_chatbot.db
DATABASE_SYNC_URL=sqlite:///./ai_chatbot.db

# ============================================
# Redis (Cache / Rate Limiting / Streaming)
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# Vector Database
# ============================================
VECTOR_DB_TYPE=chroma  # faiss | chroma
CHROMA_PERSIST_DIR=./data/chroma
FAISS_INDEX_PATH=./data/faiss

# ============================================
# LLM Providers
# ============================================
# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# Gemini
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash

# Groq
GROQ_API_KEY=gsk-your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
OPENROUTER_MODEL=openai/gpt-4o

# Fallback chain (comma separated)
FALLBACK_MODELS=groq,gemini,openrouter,openai

# ============================================
# Embeddings
# ============================================
EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# Live search (SerpAPI - get a key at https://serpapi.com/manage-api-key)
# ============================================
SERPAPI_API_KEY=

# ============================================
# Authentication
# ============================================
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_STREAM_PER_MINUTE=30

# ============================================
# Observability
# ============================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_your-langsmith-key-here
LANGCHAIN_PROJECT=ai-chatbot
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ============================================
# Uploads
# ============================================
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=pdf,docx,txt,csv,xlsx,xls,zip,jpg,jpeg,png,webp,mp3,wav,mp4

# ============================================
# Frontend
# ============================================
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000
